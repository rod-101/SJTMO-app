# ─── Render PostgreSQL ───────────────────────────────────────────
# Copy this value from your Render PostgreSQL → "Connection" → "External Database URL"
DATABASE_URL=postgresql://user:password@host/dbname

# ─── Server ──────────────────────────────────────────────────────
# Render sets PORT automatically. Only needed for local override.
PORT=5000

# ─── CORS ────────────────────────────────────────────────────────
# Set to your deployed frontend URL. Vite's default local dev port is 5173.
FRONTEND_URL=http://localhost:5173

# ─── Local Dev Only (used when DATABASE_URL is NOT set) ──────────
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=

# ─── JWT ───────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Required in production — server refuses to start with the dev- default secrets.
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7
# Set to true in production so the refresh cookie requires HTTPS.
COOKIE_SECURE=false

# ─── SMTP (email verification) ────────────────────────────────────
# Any SMTP relay works via nodemailer's generic transport, e.g. a transactional
# provider's SMTP relay (Resend: smtp.resend.com, SendGrid: smtp.sendgrid.net,
# Mailgun: smtp.mailgun.org) or Gmail/Workspace with an app password.
# Leave SMTP_HOST unset to fall back to logging verification emails to the
# console instead of sending them — useful for local dev.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@sjtmo.local
