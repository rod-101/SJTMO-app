# ─── Render PostgreSQL ───────────────────────────────────────────
# Copy this value from your Render PostgreSQL → "Connection" → "External Database URL"
DATABASE_URL=postgresql://user:password@host/dbname

# ─── Server ──────────────────────────────────────────────────────
# Render sets PORT automatically. Only needed for local override.
PORT=5000

# ─── CORS ────────────────────────────────────────────────────────
# Set to your Render Static Site URL after frontend is deployed
FRONTEND_URL=https://your-sjtmo-frontend.onrender.com

# ─── Local Dev Only (used when DATABASE_URL is NOT set) ──────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sjtmo_db
DB_USER=postgres
DB_PASSWORD=your_local_password
